.data
str1:   .asciiz "kien truc may tinh"
str2:   .asciiz "mips"
str3:   .asciiz ""
str4:   .asciiz "a bc def"
str5:   .asciiz "moi thu tuc co mot khung ngan xep"   # S(1)
bar:    .asciiz "|"
nl:     .asciiz "\n"

.text
.globl main
main:
        la    $a0, str1
        jal   test_case

        la    $a0, str2
        jal   test_case

        la    $a0, str3
        jal   test_case

        la    $a0, str4
        jal   test_case

        la    $a0, str5
        jal   test_case

        li    $v0, 10
        syscall

# test_case: goi reverse_words va in chuoi giua hai dau |
# Tham so  : $a0 = dia chi chuoi
# Tra ve   : khong
# Thanh ghi: $s0, $ra
test_case:
        addi  $sp, $sp, -8
        sw    $ra, 4($sp)
        sw    $s0, 0($sp)

        move  $s0, $a0
        jal   reverse_words

        li    $v0, 4
        la    $a0, bar
        syscall

        move  $a0, $s0
        syscall

        la    $a0, bar
        syscall

        la    $a0, nl
        syscall

        lw    $s0, 0($sp)
        lw    $ra, 4($sp)
        addi  $sp, $sp, 8
        jr    $ra

# strlen: tinh do dai chuoi .asciiz (thu tuc la)
# Tham so  : $a0 = dia chi chuoi
# Tra ve   : $v0 = so ky tu truoc byte 0
# Thanh ghi: $t0, $t1
strlen:
        move  $v0, $zero
        move  $t0, $a0
sl_loop:
        lbu   $t1, 0($t0)
        beq   $t1, $zero, sl_done
        addi  $v0, $v0, 1
        addi  $t0, $t0, 1
        j     sl_loop
sl_done:
        jr    $ra

# rev_range: dao tai cho doan [$a0, $a1] (thu tuc la)
# Tham so  : $a0 = dia chi ky tu dau, $a1 = dia chi ky tu cuoi
# Tra ve   : khong
# Thanh ghi: $t0, $t1
rev_range:
rr_loop:
        bgeu  $a0, $a1, rr_done # so sanh dia chi khong dau
        lbu   $t0, 0($a0)
        lbu   $t1, 0($a1)
        sb    $t1, 0($a0)
        sb    $t0, 0($a1)
        addi  $a0, $a0, 1
        addi  $a1, $a1, -1
        j     rr_loop
rr_done:
        jr    $ra

# reverse_words: dao thu tu tu tai cho (thu tuc khong la)
# Tham so  : $a0 = dia chi chuoi
# Tra ve   : khong
# Thanh ghi: $s0, $s1, $s2, $ra (khung 16 byte)
reverse_words:
        addi  $sp, $sp, -16     # mo dau: cap khung 4 word
        sw    $ra, 12($sp)
        sw    $s0, 8($sp)
        sw    $s1, 4($sp)
        sw    $s2, 0($sp)

        move  $s0, $a0          # $s0 = dia chi dau chuoi
        jal   strlen            # $v0 = do dai chuoi
        slti  $t0, $v0, 2
        bne   $t0, $zero, rw_done # neu do dai < 2 thi khong can dao

        # Buoc 1: Dao toan bo chuoi
        move  $a0, $s0
        add   $a1, $s0, $v0
        addi  $a1, $a1, -1      # $a1 = dia chi ky tu cuoi
        jal   rev_range

        # Buoc 2: Duyet va dao lai tung tu
        move  $s1, $s0          # $s1 = con tro duyet
        move  $s2, $s0          # $s2 = dia chi dau tu hien tai
        li    $t2, 32           # ma ASCII dau cach ' '

rw_loop:
        lbu   $t0, 0($s1)
        beq   $t0, $zero, rw_last_word
        li    $t2, 32
        beq   $t0, $t2, rw_space
        addi  $s1, $s1, 1
        j     rw_loop

rw_space:
        move  $a0, $s2
        addi  $a1, $s1, -1
        jal   rev_range
        addi  $s1, $s1, 1
        move  $s2, $s1          # bat dau tu moi sau dau cach
        j     rw_loop

rw_last_word:
        move  $a0, $s2
        addi  $a1, $s1, -1
        jal   rev_range

rw_done:
        lw    $s2, 0($sp)       # ket thuc: khoi phuc thanh ghi
        lw    $s1, 4($sp)
        lw    $s0, 8($sp)
        lw    $ra, 12($sp)
        addi  $sp, $sp, 16      # thu hoi khung
        jr    $ra