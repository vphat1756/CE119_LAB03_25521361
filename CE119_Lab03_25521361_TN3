.data
n_val:  .word 20                # Thay doi n tai day (0, 1, 2, 10, 12, 15, 19, 20)
msg1:   .asciiz "F("
msg2:   .asciiz ") = "

.text
.globl main
main:
        lw    $s0, n_val        # Doc n tu bo nho
        move  $a0, $s0
        jal   fib_rec           # Doi thanh jal fib_iter khi do ban lap
        move  $s1, $v0          # Luu ket qua F(n)

        # In chuoi "F(n) = <ket qua>"
        li    $v0, 4
        la    $a0, msg1
        syscall

        move  $a0, $s0
        li    $v0, 1
        syscall

        li    $v0, 4
        la    $a0, msg2
        syscall

        move  $a0, $s1
        li    $v0, 1
        syscall

        li    $v0, 10           # Thoat chuong trinh
        syscall

# fib_rec: tinh so Fibonacci thu n bang de quy
# Tham so : $a0 = n (n >= 0)
# Tra ve  : $v0 = F(n)
# Thanh ghi: $s0, $s1, $ra (duoc cat vao khung ngan xep 12 byte)
fib_rec:
        addi  $sp, $sp, -12     # Mo dau: cap khung 3 word
        sw    $ra, 8($sp)       # Cat dia chi tro ve
        sw    $s0, 4($sp)       # Cat $s0 cua nguoi goi
        sw    $s1, 0($sp)       # Cat $s1 cua nguoi goi

        move  $s0, $a0          # Giu gia tri n trong $s0
        slti  $t0, $s0, 2       # Kiem tra n < 2
        beq   $t0, $zero, fr_rec
        move  $v0, $s0          # Truong hop co so: F(0)=0, F(1)=1 -> tra ve n
        j     fr_done

fr_rec:
        addi  $a0, $s0, -1      # Tinh F(n - 1)
        jal   fib_rec
        move  $s1, $v0          # Giu ket qua F(n - 1) qua loi goi thu hai

        addi  $a0, $s0, -2      # Tinh F(n - 2)
        jal   fib_rec
        add   $v0, $s1, $v0     # F(n) = F(n - 1) + F(n - 2)

fr_done:
        lw    $s1, 0($sp)       # Ket thuc: nap lai dung offset
        lw    $s0, 4($sp)
        lw    $ra, 8($sp)
        addi  $sp, $sp, 12      # Thu hoi khung
        jr    $ra

# fib_iter: tinh F(n) bang vong lap
# Tham so : $a0 = n
# Tra ve  : $v0 = F(n)
# Thanh ghi: $t0-$t3 (thu tuc la)
fib_iter:
        move  $v0, $zero        # a = F(0)
        li    $t0, 1            # b = F(1)
        move  $t1, $zero        # i = 0
fi_loop:
        slt   $t2, $t1, $a0
        beq   $t2, $zero, fi_done
        addu  $t3, $v0, $t0     # a + b
        move  $v0, $t0
        move  $t0, $t3
        addiu $t1, $t1, 1
        j     fi_loop
fi_done:
        jr    $ra